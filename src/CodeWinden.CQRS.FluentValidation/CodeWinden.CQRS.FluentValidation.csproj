<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CodeWinden.CQRS.FluentValidation</PackageId>
    <Version>1.0.0</Version>
    <Title>CodeWinden.CQRS.FluentValidation</Title>
    <Description>Extension for CodeWinden.CQRS to handle validation through FluentValidation.</Description>
    <Authors>Aäron Faes</Authors>
    <Company>CodeWinden</Company>
    <Product>CodeWinden.CQRS.FluentValidation</Product>
    <PackageTags>CQRS;FluentValidation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/aaronfaes/CodeWinden.CQRS</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl> 
    <RootNamespace>CodeWinden.CQRS.FluentValidation</RootNamespace>
    <AssemblyName>CodeWinden.CQRS.FluentValidation</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CodeWinden.CQRS/CodeWinden.CQRS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
